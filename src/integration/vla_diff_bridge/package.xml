<?xml version="1.0"?>
<package format="2">
  <name>vla_diff_bridge</name>
  <version>0.3.0</version>
  <description>Drop-in FAST-LIO, camera, host VLA and isolated Diff-Planner preview integration.</description>
  <maintainer email="maintainer@example.com">VLA Planner Maintainer</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>nav_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <exec_depend>diff_planner</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <test_depend>python3-nose</test_depend>
</package>
