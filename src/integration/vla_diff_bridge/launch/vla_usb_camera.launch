<launch>
  <!-- Dedicated monocular USB camera used only as the VLA visual input. -->
  <arg name="video_device"
       default="/dev/v4l/by-id/usb-KINGSEN_KS2A418-2.0-video-index0"/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="framerate" default="30"/>
  <arg name="pixel_format" default="mjpeg"/>
  <arg name="io_method" default="mmap"/>
  <!-- Must match camera_name in the ROS calibration YAML. Topic names still
       come from the node name (/vla_usb_camera/*). -->
  <arg name="camera_name" default="head_camera"/>
  <arg name="camera_frame" default="vla_usb_camera_optical_frame"/>
  <arg name="camera_info_url"
       default="file://$(env HOME)/.ros/camera_info/head_camera.yaml"/>

  <node pkg="usb_cam" type="usb_cam_node" name="vla_usb_camera"
        output="screen" required="true">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="io_method" value="$(arg io_method)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="camera_frame_id" value="$(arg camera_frame)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
  </node>
</launch>
