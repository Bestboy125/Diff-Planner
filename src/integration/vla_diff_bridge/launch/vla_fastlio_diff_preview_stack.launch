<launch>
  <!-- All runtime groups default to false. Enabling this file never arms or controls PX4. -->
  <arg name="start_diff_planner_preview" default="false"/>
  <arg name="start_network_bridge" default="false"/>
  <arg name="start_observation_uplink" default="false"/>

  <arg name="drone_id" default="0"/>
  <arg name="odom_topic" default="/ekf/ekf_odom"/>
  <arg name="cloud_topic" default="/laserMapping/cloud_registered"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="image_compressed_topic" default="/camera/color/image_raw/compressed"/>
  <arg name="world_frame" default="world"/>
  <arg name="body_frame" default="base_link"/>
  <arg name="camera_frame" default="camera_color_optical_frame"/>

  <arg name="backend_url" default="http://192.168.14.250:8080"/>
  <arg name="allowed_host_ip" default="192.168.14.250"/>
  <arg name="bridge_token" default="REQUIRED"/>
  <arg name="observation_token" default="REQUIRED"/>
  <arg name="calibration_id" default="REQUIRED"/>
  <arg name="calibration_validated" default="false"/>

  <arg name="preview_goal_topic" default="/vla/preview_goal"/>
  <arg name="preview_yaw_topic" default="/vla/preview_yaw"/>
  <arg name="optimized_preview_topic" default="/vla/optimized_trajectory_preview"/>

  <group if="$(arg start_diff_planner_preview)">
    <!-- The unmodified Diff-Planner subscribes to /goal. Scope-local remapping isolates it. -->
    <remap from="/goal" to="$(arg preview_goal_topic)"/>
    <include file="$(find diff_planner)/launch/include/advanced_param_exp.xml">
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="drone_id" value="$(arg drone_id)"/>
      <arg name="camera_pose_topic" value="no_use0"/>
      <arg name="depth_topic" value="no_use1"/>
      <arg name="cloud_topic" value="$(arg cloud_topic)"/>
      <arg name="cx" value="319.31427001953125"/>
      <arg name="cy" value="239.09725952148438"/>
      <arg name="fx" value="386.2706298828125"/>
      <arg name="fy" value="386.2706298828125"/>
      <arg name="max_vel" value="0.5"/>
      <arg name="max_acc" value="3.0"/>
      <arg name="max_jer" value="20.0"/>
      <arg name="planning_horizon" value="7.5"/>
      <arg name="local_map_size_x" value="5.5"/>
      <arg name="local_map_size_y" value="5.5"/>
      <arg name="local_map_size_z" value="2.0"/>
      <arg name="enable_virtual_wall" value="true"/>
      <arg name="virtual_ceil" value="2.0"/>
      <arg name="virtual_ground" value="0.1"/>
      <arg name="map_resolution" value="0.2"/>
      <arg name="inflation_size" value="0.4"/>
      <arg name="init_x" value="0.0"/>
      <arg name="init_y" value="0.0"/>
      <arg name="init_z" value="0.0"/>
      <arg name="flight_type" value="1"/>
      <arg name="point_num" value="1"/>
      <arg name="point0_x" value="0.0"/>
      <arg name="point0_y" value="0.0"/>
      <arg name="point0_z" value="0.0"/>
      <arg name="point1_x" value="0.0"/>
      <arg name="point1_y" value="0.0"/>
      <arg name="point1_z" value="0.0"/>
      <arg name="point2_x" value="0.0"/>
      <arg name="point2_y" value="0.0"/>
      <arg name="point2_z" value="0.0"/>
      <arg name="point3_x" value="0.0"/>
      <arg name="point3_y" value="0.0"/>
      <arg name="point3_z" value="0.0"/>
      <arg name="point4_x" value="0.0"/>
      <arg name="point4_y" value="0.0"/>
      <arg name="point4_z" value="0.0"/>
    </include>

    <node pkg="diff_planner" name="vla_preview_traj_server" type="traj_server"
          output="screen" required="true">
      <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
      <remap from="~heartbeat" to="/drone_$(arg drone_id)_traj_server/heartbeat"/>
      <remap from="/planning/yaw" to="$(arg preview_yaw_topic)"/>
      <remap from="/position_cmd" to="$(arg optimized_preview_topic)"/>
      <param name="traj_server/time_forward" value="1.0" type="double"/>
      <param name="traj_server/yaw_dot_max" value="3.14" type="double"/>
      <param name="traj_server/yaw_dot_dot_max" value="15.71" type="double"/>
    </node>
  </group>

  <group if="$(arg start_network_bridge)">
    <include file="$(find vla_diff_bridge)/launch/vla_diff_bridge.launch">
      <arg name="auth_token" value="$(arg bridge_token)"/>
      <arg name="allowed_host_ip" value="$(arg allowed_host_ip)"/>
      <arg name="live_publish_enabled" value="false"/>
      <arg name="preview_only_mode" value="true"/>
      <arg name="planning_preview_enabled" value="true"/>
      <arg name="expected_calibration_id" value="$(arg calibration_id)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="world_frame" value="$(arg world_frame)"/>
      <arg name="body_frame" value="$(arg body_frame)"/>
      <arg name="camera_frame" value="$(arg camera_frame)"/>
      <arg name="goal_topic" value="/vla/disabled/control_goal"/>
      <arg name="yaw_topic" value="/vla/disabled/control_yaw"/>
      <arg name="hover_stop_topic" value="/vla/disabled/hover_stop"/>
      <arg name="mandatory_stop_topic" value="/vla/disabled/mandatory_stop"/>
      <arg name="preview_goal_topic" value="$(arg preview_goal_topic)"/>
      <arg name="preview_yaw_topic" value="$(arg preview_yaw_topic)"/>
    </include>
  </group>

  <group if="$(arg start_observation_uplink)">
    <include file="$(find vla_diff_bridge)/launch/onboard_observation_uplink.launch">
      <arg name="backend_url" value="$(arg backend_url)"/>
      <arg name="observation_token" value="$(arg observation_token)"/>
      <arg name="calibration_id" value="$(arg calibration_id)"/>
      <arg name="calibration_validated" value="$(arg calibration_validated)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="world_frame" value="$(arg world_frame)"/>
      <arg name="body_frame" value="$(arg body_frame)"/>
      <arg name="camera_frame" value="$(arg camera_frame)"/>
      <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
      <arg name="image_compressed_topic" value="$(arg image_compressed_topic)"/>
      <arg name="planner_preview_topic" value="$(arg optimized_preview_topic)"/>
    </include>
  </group>
</launch>
